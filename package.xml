<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mission_database</name>
  <version>0.1.0</version>
  <description>
    SQLite-backed breadcrumb trail for Warthog robots. Stores GPS positions
    annotated with comms status on disk rather than in RAM. Provides a ROS2
    service for querying the trail with optional filters.
  </description>

  <maintainer email="you@example.com">Your Name</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>west_point_comms_sim</depend>
  <depend>rosidl_default_runtime</depend>
  <depend>ros2launch</depend>

  <!-- SQLite3 system library (Ubuntu: libsqlite3-dev) -->
  <build_depend>libsqlite3-dev</build_depend>
  <exec_depend>libsqlite3-dev</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>